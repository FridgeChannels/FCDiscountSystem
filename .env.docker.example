# Public entry URL for browser + iframe game shells.
# Docker nginx exposes this on PUBLIC_PORT (default 8080).
PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_PORT=8080

# Engine repository backend: memory (demo) | supabase (production)
FC_REPO=supabase
FC_CACHE=memory

# Required when FC_REPO=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Redis when FC_CACHE=redis
REDIS_URL=
REDIS_KEY_PREFIX=fc:

# Bottom dev toolbar (scene preview). Default off; only applies to local vite dev.
VITE_DEV_TOOLBAR_ENABLED=false

# Optional RSA keys for manifest signature verification.
MANIFEST_PRIVATE_KEY_PEM=
VITE_MANIFEST_PUBLIC_KEY_PEM=
VITE_MANIFEST_REQUIRE_SIGNATURE=false
