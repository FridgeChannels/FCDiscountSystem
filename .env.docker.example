# Docker 部署模板 — 复制为 .env 后按服务器修改
# 目录布局:
#   <parent>/
#     FCDiscountSystem/
#     fc-platform/

# 浏览器访问的公网地址（必填，改成域名或弹性 IP）
PUBLIC_BASE_URL=http://YOUR_PUBLIC_IP_OR_DOMAIN:8080
PUBLIC_PORT=8080

# Redis 容器所在 Docker 网络（docker network ls 查看，常见 docker_default）
REDIS_EXTERNAL_NETWORK=docker_default

FC_REPO=supabase
FC_CACHE=redis

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Redis 与 fc-engine 在同一 Docker 网络时用服务名（你的容器 docker-redis-1 → 服务名 redis）
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=fc:

COUPON_API_BASE_URL=https://YOUR-COUPON-API-HOST
COUPON_API_AUTH_TOKEN=YOUR-BEARER-TOKEN
COUPON_API_TIMEOUT_MS=15000
COUPON_API_MAX_RETRY=2
REWARD_PLAN_AVAILABLE_CAMPAIGN_TIMEOUT_MS=15000

SURVEY_API_BASE_URL=https://YOUR-SURVEY-API-HOST
SURVEY_API_KEY=YOUR-SURVEY-KEY
SURVEY_POINTS_PER_QUESTION=10

VITE_DEV_TOOLBAR_ENABLED=false
VITE_MANIFEST_REQUIRE_SIGNATURE=false
MANIFEST_PRIVATE_KEY_PEM=
VITE_MANIFEST_PUBLIC_KEY_PEM=
