# ===== Docker Compose 入口配置（服务器：/data/fc-coupon-game/FCDiscountSystem/.env）=====
# 改 PUBLIC_BASE_URL 为你的公网域名或弹性 IP，浏览器必须能访问
PUBLIC_BASE_URL=https://dealquest.fridgechannels.com
PUBLIC_PORT=8088

# Redis 所在 compose 网络（服务器上执行 docker network ls 确认，一般是 docker_default）
REDIS_EXTERNAL_NETWORK=docker_default

# ===== 引擎 / Supabase =====
FC_REPO=supabase
FC_CACHE=redis
SUPABASE_URL=https://vggkiumpajbvaxiflrtu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZnZ2tpdW1wYWpidmF4aWZscnR1Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2ODk0NTc2NywiZXhwIjoyMDg0NTIxNzY3fQ.hKISZxpPAdvHMAR6L2VWq01HYPmG8xTGPw1rQvVSgdU

# ===== Redis（必须用容器名 docker-redis-1，不要用 redis 服务名）=====
REDIS_URL=redis://docker-redis-1:6379
REDIS_KEY_PREFIX=fc:

# ===== 券系统 API（engine 启动必填）=====
COUPON_API_BASE_URL=http://172.31.9.165:8080
COUPON_API_AUTH_TOKEN=RTx7xJmgqdmh_UxwPLlmO6o2I_189JLH1HlkfsTqOOML0193
COUPON_API_TIMEOUT_MS=15000
COUPON_API_MAX_RETRY=2
REWARD_PLAN_AVAILABLE_CAMPAIGN_TIMEOUT_MS=15000

# ===== 问卷 API =====
SURVEY_API_BASE_URL=http://172.31.9.165:8080
SURVEY_API_KEY=RTx7xJmgqdmh_UxwPLlmO6o2I_189JLH1HlkfsTqOOML0193
SURVEY_POINTS_PER_QUESTION=10

# ===== 演示隐藏开关：左上角 logo 连点 5 次强制结束周期（BFF + engine + 前端）=====
FC_DEMO_FORCE_RENEW_ENABLED=true
VITE_DEMO_FORCE_RENEW_ENABLED=true

# ===== 前端构建（Docker web 镜像 build args）=====
VITE_DEV_TOOLBAR_ENABLED=false
VITE_MANIFEST_REQUIRE_SIGNATURE=false
MANIFEST_PRIVATE_KEY_PEM=
VITE_MANIFEST_PUBLIC_KEY_PEM=
